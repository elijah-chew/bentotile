olio || layer.error || layer.success || layer.id) {\n    payload = layer\n    break\n  }\n}\nconst portfolio = payload.portfolio || (payload.id ? payload : null)\nconst errorCode = typeof payload.error === 'string' ? payload.error : (payload.error?.code || payload.error?.message || '')\nreturn {\n  ok: !!(portfolio && portfolio.id),\n  id: portfolio?.id || '',\n  portfolio: portfolio || null,\n  limit: errorCode === 'PLAN_LIMIT_REACHED',\n  message: payload.message || ''\n}","name":"Create portfolio from site name","next":"CHECK_OK","type":"custom-js","__wwdescription":"Call create_portfolio with the site name, using the session token from the app or localStorage."},"CHECK_OK":{"id":"CHECK_OK","name":"Created a bento?","next":null,"type":"if","value":{"code":"return !!context.workflow['CREATE']?.result?.ok","__wwtype":"js","defaultValue":false},"branches":[{"id":"GO_EDITOR","value":true},{"id":"GO_DASHBOARD","value":false}],"__wwdescription":"Leave /create when a portfolio id exists."},"GO_EDITOR":{"id":"GO_EDITOR","mode":"page","name":"Go to new editor","next":null,"type":"change-page","pageId":"867d2a7d-5bc3-4339-bcc5-1081ba27dbba","parameters":{"portfolioid":{"code":"return context.workflow['CREATE']?.result?.id || ''","__wwtype":"js"}},"navigateMode":"internal","openInNewTab":false,"loadProgress":false,"loadProgressColor":"#000000","__wwdescription":"Open the new portfolio in the editor."},"GO_DASHBOARD":{"id":"GO_DASHBOARD","mode":"page","name":"Go to dashboard","next":null,"type":"change-page","pageId":"f85a6374-b40e-4732-b182-92e8dc6c019e","navigateMode":"internal","openInNewTab":false,"loadProgress":false,"loadProgressColor":"#000000","__wwdescription":"Send the user to the dashboard when create cannot add another bento."},"GO_ERROR":{"id":"GO_ERROR","mode":"page","name":"Go to dashboard after error","next":null,"type":"change-page","pageId":"f85a6374-b40e-4732-b182-92e8dc6c019e","navigateMode":"internal","openInNewTab":false,"loadProgress":false,"loadProgre